theme = Alabaster
# Liga SFMono Nerd Font: SF Mono with Fira Code's ligatures (|> as a
# triangle, -> as an arrow, == != <= :: ...) and Nerd Font icons.  Also
# installed, to switch to:
#   font-family = Liga Hack (Hack with the same Fira Code ligatures)
#   font-family = psudoFont Liga Mono (Menlo; its |> barely changes)
#   font-family = Lilex Nerd Font Mono
#   font-family = Paper Mono, with font-feature = ss01 (ligatures) and
#   adjust-cell-height = 8
#   font-family = SF Mono (Apple's original, no ligatures)
# Liga SFMono, Liga Hack and Paper Mono are not marked monospace, so plain
# `ghostty +list-fonts' omits them; add --family="..." to see them.
font-family = Liga SFMono Nerd Font
font-size = 17
command = /Users/altaria/.nix-profile/bin/fish

keybind = super+j=goto_split:down
keybind = super+k=goto_split:up
keybind = super+l=goto_split:right
keybind = super+h=goto_split:left
keybind = super+r=reload_config
macos-option-as-alt = true

# Thicker bar cursor, so the bar Hel/Helix use in the terminal is easy to see.
adjust-cursor-thickness = 200%

# Cmd+C copies Ghostty's own selection when there is one; otherwise the key
# goes to the program, so terminal Emacs can copy its selection.
keybind = performable:super+c=copy_to_clipboard:mixed

# Cmd+Z / Cmd+Shift+Z go to the program (undo/redo in Emacs) instead of
# Ghostty's own undo, which reopens closed splits and tabs.
keybind = super+z=unbind
keybind = super+shift+z=unbind
